# Database Configuration:
# - To connect to an external PostgreSQL database (Neon, Supabase, Railway, Docker, or local Postgres):
#   DATABASE_URL=postgresql://postgres:password@localhost:5432/app_db
# - If left empty or omitted, Study OS automatically runs on an embedded, persistent local database.
DATABASE_URL=

# AI Provider Configuration (Server-side secrets — do NOT prefix with NEXT_PUBLIC_):
AI_API_KEY=
AI_BASE_URL=https://api.bazaarlink.ai/v1
AI_MODEL=
